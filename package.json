{
  "name": "dawn-of-sorcerer-electron",
  "productName": "Dawn of Sorcerer",
  "version": "0.1.0",
  "description": "Dawn of Sorcerer - packaged desktop build",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps || true",
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:web": "vite build --outDir build/web",
    "build": "npm run build:web",
    "dist": "npm run build && electron-builder --win nsis",
    "start": "electron ."
  },
  "author": "Generated",
  "license": "MIT",
  "dependencies": {
    "electron": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.0.0",
    "electron-builder": "^24.6.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.example.dawnofsorcerer",
    "productName": "Dawn of Sorcerer",
    "files": [
      "build/web/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
